# PostgreSQL
POSTGRES_DB=transcendence
POSTGRES_USER=db_user
POSTGRES_PASSWORD=db_password
# Optional, default: db (the docker-compose service)
# POSTGRES_HOST=db

# Django
# Secret key for signing tokens: use a long random string, e.g.
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
# True for local development, False for production
DEBUG=True
# Optional, comma-separated. Defaults work for https://localhost:5001
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost,https://localhost:5001

# Redis (channel layer for WebSocket)
REDIS_HOST=redis

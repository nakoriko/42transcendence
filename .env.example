#PostgreSQL
POSTGRES_DB=transcendence
POSTGRES_USER=db_user
POSTGRES_PASSWORD=db_password

#DJANGO
#key per signature (importante)
DJANGO_SECRET_KEY=secret_key 
#true - для разработки, false - for production
DEBUG=True
DATABASE_URL=postgres://db_user:db_password@db5432/transcendence

#REDIS:
REDIS_URL=redis://redis:6379